# Use a separate Supabase test project with schema.sql applied.
# Two distinct, email-confirmed test accounts. Never use a secret/service-role key.
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_KEY=your-publishable-key
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
